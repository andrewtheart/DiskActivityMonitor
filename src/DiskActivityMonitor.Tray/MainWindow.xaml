<Window x:Class="DiskActivityMonitor.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiskActivityMonitor.Tray.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Disk Activity Monitor" Height="720" Width="940"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- WindowChrome gives a frameless window without the 1px white DWM frame line that
         WindowStyle=None otherwise shows at the top. CaptionHeight=0 leaves dragging to our
         own handler; ResizeBorderThickness keeps the window resizable. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#15181B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="Width" Value="90" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Compact square icon button used for the per-file row actions (tail, trace, delete).
             The glyph is supplied as an explicit TextBlock by each button, so the symbol font is
             applied directly rather than relying on ContentPresenter font inheritance. -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C333C" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive variant: red only on hover so the row stays calm at rest. -->
        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A2226" />
                                <Setter Property="Foreground" Value="#FF8A80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monospaced surface shared by the handle trace and live tail viewers. -->
        <Style x:Key="ConsoleText" TargetType="TextBox">
            <Setter Property="Background" Value="#101316" />
            <Setter Property="Foreground" Value="#D6DCE3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (the OS title bar is removed); drag anywhere on this strip to move the window -->
        <Grid Grid.Row="0" Height="30" Background="{StaticResource WindowBg}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource CloseButton}" Height="30" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="&#x2715;" ToolTip="Close" Click="Close_Click" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="16,2,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="HeaderAppIcon" Width="42" Height="42" Margin="0,0,11,0"
                       Source="/DiskActivityMonitor.Tray;component/Assets/app-icon.png"
                       Stretch="Uniform" AutomationProperties.Name="Disk Activity Monitor icon" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Disk Activity Monitor" Style="{StaticResource H1}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}"
                               Text="Tracking SSD write volume to protect drive endurance" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Disk" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="DiskSelector" Width="280" DisplayMemberPath="Display"
                          SelectionChanged="DiskSelector_SelectionChanged" />
                <Button Content="Refresh" Style="{StaticResource ToolButton}" Margin="10,0,0,0" Click="Refresh_Click" />
                <Button x:Name="HelpButton" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Click="Help_Click" ToolTip="Help and troubleshooting" Padding="6"
                        AutomationProperties.Name="Help and troubleshooting">
                    <TextBlock Text="?" FontSize="16" FontWeight="Bold" Width="16"
                               TextAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                </Button>
                <Button x:Name="GearButton" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Gear_Click"
                        ToolTip="Settings" Padding="6">
                    <Viewbox Width="16" Height="16">
                        <Path Fill="{StaticResource TextPrimary}"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Settings page header: kept outside the scroller so Dashboard stays reachable -->
        <Grid x:Name="SettingsHeader" Grid.Row="1" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="Thresholds, auto-suspend rules, and per-drive endurance." />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                    Click="Gear_Click" Content="&#x2190;  Dashboard" ToolTip="Back to dashboard"
                    AutomationProperties.Name="Back to dashboard" />
        </Grid>

        <ScrollViewer x:Name="BodyScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
            <StackPanel x:Name="DashboardPanel">

                <!-- Summary cards -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="WRITTEN TODAY" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TodayMetric" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                            <TextBlock x:Name="TodayReadSub" Style="{StaticResource Caption}" Text="read -" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="1" Margin="7,0,7,0">
                        <StackPanel>
                            <TextBlock Text="LAST 24 HOURS" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="Day24Metric" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                            <TextBlock x:Name="Day24ReadSub" Style="{StaticResource Caption}" Text="read -" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="2" Margin="7,0,7,0">
                        <StackPanel>
                            <TextBlock Text="LAST 7 DAYS" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="Week7Metric" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                            <TextBlock x:Name="Week7AvgSub" Style="{StaticResource Caption}" Text="avg -/day" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="3" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SSD ENDURANCE" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="WearMetric" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                            <TextBlock x:Name="WearSub" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Projected lifespan at the current write rate." Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SSD endurance detail -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Header: title + rated-TBW badge -->
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="SSD endurance" />
                                <TextBlock x:Name="EnduranceDiskText" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="" />
                            </StackPanel>
                            <Button x:Name="EnduranceRatedBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#2A2E34" BorderThickness="0" Padding="11,4" Cursor="Hand"
                                    ToolTip="Click to change this drive's TBW rating; right-click for lookup options"
                                    Click="EditRatedTbw_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#343A42" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#3D444D" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="EditRatedTbw_Click">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource Accent}" FontSize="15"
                                                               Margin="0,0,9,0" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="Change rated TBW" FontWeight="SemiBold" />
                                                        <TextBlock Text="Enter one value or a range"
                                                                   Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Click="LookupRatedTbw_Click">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource Accent}" FontSize="15"
                                                               Margin="0,0,9,0" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="Look up rated TBW" FontWeight="SemiBold" />
                                                        <TextBlock Text="Search the web with the local model"
                                                                   Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock x:Name="EnduranceRatedText" Text="150 to 600 TBW estimated"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Two headline metrics: lifetime wear (SMART) and projected lifespan -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DRIVE LIFE USED" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="SmartWearValue" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,10" />
                                <Grid Height="8">
                                    <Border Background="#15181B" CornerRadius="4"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1" />
                                    <Grid Margin="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="SmartWearFillCol" Width="0*" />
                                            <ColumnDefinition x:Name="SmartWearRestCol" Width="100*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#3FB950" Offset="0" />
                                                    <GradientStop Color="#E04A4A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="SmartWearText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,7,0,0" Text="from the drive's SMART data" />
                                <TextBlock x:Name="SmartWearLifeText" Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Margin="0,8,0,0" Text="" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PROJECTED LIFESPAN" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="EnduranceProjValue" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,10" />
                                <TextBlock x:Name="EnduranceProjSub" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="at the current write rate" />
                            </StackPanel>
                        </Grid>

                        <!-- Average write rate -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Avg while monitored" VerticalAlignment="Center" Margin="0,0,18,0"
                                           Foreground="{StaticResource TextSecondary}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="EnduranceAvgHour" Style="{StaticResource H2}" Text="-" />
                                    <TextBlock Text="per hour" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="EnduranceAvgDay" Style="{StaticResource H2}" Text="-" />
                                    <TextBlock Text="per day" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock x:Name="EnduranceAvgWeek" Style="{StaticResource H2}" Text="-" />
                                    <TextBlock Text="per week" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="EnduranceConsumedText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Opacity="0.75" Margin="0,12,0,0" Text="-" />

                    </StackPanel>
                </Border>

                <!-- Live physical-disk activity from the collector's granular sample stream -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Live disk activity" />
                                <TextBlock x:Name="LiveDiskCaption" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" Text="Physical read/write throughput from granular collector samples" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="10" Height="3" Background="#4FC3F7" Margin="0,0,6,0" />
                                <TextBlock Text="Read" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                                <Border Width="10" Height="3" Background="#FFA726" Margin="0,0,6,0" />
                                <TextBlock Text="Write" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="170" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LiveDiskCurrent" Style="{StaticResource Caption}" />
                            <ctl:LiveDiskChart x:Name="LiveDiskActivityChart" Grid.Row="1" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Trend chart -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TrendTitle" Style="{StaticResource H2}" Text="Write volume per hour" />
                                <TextBlock Style="{StaticResource Caption}" Text="Bars show bytes written to the device in each bucket" Margin="0,2,0,0" />
                                <TextBlock x:Name="TrendTimeZoneText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton x:Name="Btn24h" Style="{StaticResource ToggleTool}" Content="24h" Click="Range_Click" />
                                <ToggleButton x:Name="Btn30d" Style="{StaticResource ToggleTool}" Content="30d" Margin="6,0,0,0" Click="Range_Click" />
                                <ToggleButton x:Name="Btn12w" Style="{StaticResource ToggleTool}" Content="12w" Margin="6,0,0,0" Click="Range_Click" />
                            </StackPanel>
                        </Grid>
                        <ctl:BarChart x:Name="Chart" Height="230" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Throughput (MB/s): average / median / peak over a period -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Disk throughput (MB/s)" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Average, median and busiest-minute I/O rate over the selected period" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton x:Name="TpBtn1h" Style="{StaticResource ToggleTool}" Content="1h" Click="ThroughputRange_Click" />
                                <ToggleButton x:Name="TpBtn24h" Style="{StaticResource ToggleTool}" Content="24h" Margin="6,0,0,0" Click="ThroughputRange_Click" />
                                <ToggleButton x:Name="TpBtn7d" Style="{StaticResource ToggleTool}" Content="7d" Margin="6,0,0,0" Click="ThroughputRange_Click" />
                                <ToggleButton x:Name="TpBtn30d" Style="{StaticResource ToggleTool}" Content="30d" Margin="6,0,0,0" Click="ThroughputRange_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AVERAGE" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ThroughputAvg" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                                <TextBlock Text="MB/s" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MEDIAN" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ThroughputMedian" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                                <TextBlock Text="MB/s" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PEAK" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ThroughputPeak" Style="{StaticResource Metric}" Text="-" Margin="0,4,0,0" />
                                <TextBlock Text="MB/s &#183; busiest minute" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>

                        <ctl:BarChart x:Name="ThroughputChart" Height="150" Margin="0,16,0,0" />
                        <TextBlock x:Name="ThroughputCoverageText" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Processes + Alerts -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,7,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource H2}" Text="Top application write requests" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProcessRangeSelector" Grid.Column="1" Width="150"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="ProcessRange_SelectionChanged" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Logical file-write bytes requested by each process - useful for finding culprits, but not physical disk writes or SSD wear. svchost shows its hosted service when known. Hover over a bar or click a row to see which files it wrote."
                                       Margin="0,2,0,10" />
                            <ItemsControl x:Name="ProcessList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" Background="Transparent" Cursor="Hand"
                                              MouseLeftButtonUp="ProcessRow_Click"
                                              ToolTip="Click to see which files this process wrote"
                                              AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Height="14" CornerRadius="3" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}" VerticalAlignment="Center"
                                                    MouseEnter="ProcessBar_MouseEnter"
                                                    MouseLeave="ProcessBar_MouseLeave"
                                                    ToolTip="Hover to see which files this process wrote">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#4FC3F7" Offset="0" />
                                                        <GradientStop Color="#2979FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding WriteText}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ProcessEmpty" Style="{StaticResource Caption}"
                                       Text="No significant process writes recorded yet." Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="1" Margin="7,0,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource H2}" Text="Alert center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="124" Height="28" Margin="0,0,9,0" Background="#15181B"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                            <TextBox x:Name="AlertSearchBox" Grid.Column="1" Background="Transparent"
                                                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                                                     BorderThickness="0" Padding="0" FontSize="11.5"
                                                     VerticalContentAlignment="Center" ToolTip="Filter alerts by keyword"
                                                     AutomationProperties.Name="Filter alerts by keyword" />
                                            <Button x:Name="AlertSearchClearButton" Grid.Column="2"
                                                    Style="{StaticResource ToolButton}" Content="&#x2715;"
                                                    FontFamily="Segoe UI" FontSize="10" Padding="0"
                                                    Width="22" Height="22" Background="Transparent" BorderThickness="0"
                                                    Visibility="Collapsed" ToolTip="Clear alert search"
                                                    AutomationProperties.Name="Clear alert search"
                                                    Click="AlertSearchClear_Click" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Style="{StaticResource Caption}" Text="Last hour" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,7,0" />
                                    <Button x:Name="ShowAllAlertsButton" Content="All alerts" Click="ShowAllAlerts_Click"
                                            Style="{StaticResource ToolButton}" Padding="7,2" Background="Transparent"
                                            BorderThickness="0" Foreground="{StaticResource Accent}"
                                            AutomationProperties.Name="All alerts including dismissed" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="AlertList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#15181B" CornerRadius="6" Padding="10,7" Margin="0,0,0,7">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Click="RunSmartScan_Click" CommandParameter="{Binding}"
                                                              Visibility="{Binding SmartActionVisibility}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{StaticResource Accent}" FontSize="15"
                                                                           Margin="0,0,9,0" VerticalAlignment="Center" />
                                                                <StackPanel>
                                                                    <TextBlock Text="Run live SMART scan" FontWeight="SemiBold" />
                                                                    <TextBlock Text="Read-only drive health check" Style="{StaticResource Caption}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <Separator Visibility="{Binding SmartActionVisibility}" />
                                                    <MenuItem Header="Dismiss from Alert center" Click="DismissAlert_Click"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding SeverityBrush}" CornerRadius="2" Margin="0,0,9,0" />
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <Button x:Name="AlertDismissButton" Grid.Column="2"
                                                            Style="{StaticResource AlertDismissButton}" Content="&#x2715;"
                                                                Margin="6,-3,-4,-3" ToolTip="Dismiss from Alert center"
                                                                AutomationProperties.Name="Dismiss alert"
                                                                CommandParameter="{Binding}" Click="DismissAlert_Click" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" />
                                                    <TextBlock Text="Right-click for live SMART scan" Visibility="{Binding SmartActionVisibility}"
                                                               Foreground="{StaticResource Accent}" FontSize="10.5" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AlertEmpty" Style="{StaticResource Caption}"
                                       Text="No visible alerts in the last hour. Dismissed alerts remain available under All alerts." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Suspended processes: every suspension this app made, always resumable here -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource H2}" Text="Suspended processes" VerticalAlignment="Center" />
                            <Button x:Name="ResumeAllSuspendedButton" Grid.Column="1" Content="Resume all"
                                    Style="{StaticResource ToolButton}" Padding="9,3" Visibility="Collapsed"
                                    ToolTip="Resume every process suspended by Disk Activity Monitor"
                                    AutomationProperties.Name="Resume all suspended processes"
                                    Click="ResumeAllSuspended_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Processes Disk Activity Monitor suspended - by an auto-suspend rule or by you from an alert. Each stays listed here until it is resumed; timed suspensions resume themselves when the interval ends." />
                        <ItemsControl x:Name="SuspendedProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15181B" CornerRadius="6" Padding="10,7" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Background="#232A33" CornerRadius="4" Padding="6,1"
                                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Resume" Style="{StaticResource ToolButton}"
                                                    Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    CommandParameter="{Binding}" Click="ResumeSuspendedProcess_Click"
                                                    AutomationProperties.Name="{Binding ResumeAutomationName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SuspendedProcessEmpty" Style="{StaticResource Caption}"
                                   Text="No processes are suspended by Disk Activity Monitor." />
                        <TextBlock x:Name="SuspendedProcessStatus" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <!-- Auto-suspend rules -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Auto-suspend rules" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"
                                   Text="Suspend a process when it writes more than its limit in a rolling hour. New rules ask for confirmation first; tick Auto to suspend without asking." />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Add a seen process" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ProcessPickList" Width="200" />
                                    <Button Content="Add" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="AddSeenRule_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Or pick an executable on disk" />
                                <Button Content="Browse for .exe..." Style="{StaticResource ToolButton}" Click="BrowseExe_Click" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Suspend for (minutes, 0 = until resumed)" />
                                <TextBox x:Name="TxtSuspendMinutes" Width="130" HorizontalAlignment="Left"
                                         Style="{StaticResource DarkTextBox}"
                                         AutomationProperties.Name="Default suspension minutes"
                                         ToolTip="Interval pre-selected on suspend notifications. The app resumes the process automatically when it elapses." />
                            </StackPanel>
                        </WrapPanel>

                        <ItemsControl x:Name="SuspendRuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15181B" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="limit" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Text="{Binding ThresholdText, Mode=TwoWay}" Width="56" Style="{StaticResource DarkTextBox}" />
                                                <TextBlock Text="GB/h" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Content="Auto (skip prompt)" IsChecked="{Binding IsAuto, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanAuto}"
                                                      Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                            <CheckBox Grid.Column="3" Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                            <Button Grid.Column="4" Style="{StaticResource DismissButton}" Content="&#x2715;"
                                                    ToolTip="Remove this rule" VerticalAlignment="Center" Margin="12,0,0,0" Click="RemoveRule_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SuspendRuleEmpty" Style="{StaticResource Caption}" Text="No auto-suspend rules yet." />

                        <TextBlock x:Name="SuspendedHeader" Style="{StaticResource FieldLabel}" Text="Currently suspended"
                                   Margin="0,14,0,4" Visibility="Collapsed" />
                        <ItemsControl x:Name="SuspendedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15181B" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Display}" />
                                            <Button Grid.Column="1" Content="Resume" Style="{StaticResource ToolButton}" Click="ResumeProc_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save rules" Style="{StaticResource ToolButton}" Click="SaveRules_Click" />
                            <TextBlock x:Name="SuspendStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Settings &amp; thresholds" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                   Text="Write thresholds are in GB; controller-error thresholds are Windows event counts." />
                        <WrapPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SSD warn / hour (GB)" />
                                <TextBox x:Name="TxtWarnHour" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SSD warn / day (GB)" />
                                <TextBox x:Name="TxtWarnDay" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SSD critical / day (GB)" />
                                <TextBox x:Name="TxtCritDay" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Process warn / hour (GB)" />
                                <TextBox x:Name="TxtProcHour" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="All processes warn / hour (GB)" />
                                <TextBox x:Name="TxtAllProcHour" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Alert cooldown (min)" />
                                <TextBox x:Name="TxtCooldown" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Controller window (days)" />
                                <TextBox x:Name="TxtControllerWindow" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Controller warning (events)" />
                                <TextBox x:Name="TxtControllerWarn" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Controller critical (events)" />
                                <TextBox x:Name="TxtControllerCritical" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Sample interval (s)" />
                                <TextBox x:Name="TxtInterval" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Dashboard refresh (s)" />
                                <TextBox x:Name="TxtRefresh" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Live graph history (min)" />
                                <TextBox x:Name="TxtLiveGraphRetention" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock x:Name="TbwLabel" Style="{StaticResource FieldLabel}" Text="TBW setting for this disk" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton x:Name="RadTbwSingle" GroupName="TbwRatingMode" Content="Single TBW"
                                                 Foreground="{StaticResource TextPrimary}" Checked="TbwMode_Checked" />
                                    <RadioButton x:Name="RadTbwRange" GroupName="TbwRatingMode" Content="TBW Range"
                                                 Foreground="{StaticResource TextPrimary}" Margin="16,0,0,0"
                                                 Checked="TbwMode_Checked" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="TbwLowerPanel" Margin="0,0,24,12">
                                <TextBlock x:Name="TbwLowerLabel" Style="{StaticResource FieldLabel}" Text="TBW rating (TB)" />
                                <TextBox x:Name="TxtTbw" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel x:Name="TbwUpperPanel" Margin="0,0,24,12" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum TBW (TB)" />
                                <TextBox x:Name="TxtTbwUpper" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Endurance warn (years left)" />
                                <TextBox x:Name="TxtEnduranceWarnYears" Style="{StaticResource DarkTextBox}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="High monitoring coverage (%)" />
                                <TextBox x:Name="TxtHighCoveragePercent" Width="150" Style="{StaticResource DarkTextBox}"
                                         ToolTip="Calendar-rate and endurance projections are shown only when recent monitoring coverage reaches this percentage." />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Per-file attribution: what turns an opaque writer such as System into an explanation -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,6,0,4">
                            <StackPanel>
                                <CheckBox x:Name="ChkTrackFileTargets" Foreground="{StaticResource TextPrimary}"
                                          Content="Record which files each process writes" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Text="Lets you click a process in the dashboard to see the individual files behind its writes - the only way to explain the kernel &quot;System&quot; process, which writes on behalf of the whole machine. Needs the ETW collector (the installed service)." />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Files kept per process / minute" />
                                        <TextBox x:Name="TxtFileTargetsPerProcess" Width="150" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Minimum per file (KB/min)" />
                                        <TextBox x:Name="TxtFileTargetMinKb" Width="150" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="File history (days)" />
                                        <TextBox x:Name="TxtFileTargetRetention" Width="120" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Files tracked in memory" />
                                        <TextBox x:Name="TxtFileTargetTrackingLimit" Width="150" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Database growth: warn before the monitoring history fills the disk -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,6,0,4">
                            <StackPanel>
                                <TextBlock Text="Database size" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Text="Disk Activity Monitor warns you when its own database grows past this size and offers to compact it. Compaction rebuilds the file and returns space freed by expired history without losing data. When the window is minimised or in the tray, the warning arrives as a Windows notification." />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Warn above (GB)" />
                                        <TextBox x:Name="TxtDatabaseSizeWarnGb" Width="120" Style="{StaticResource DarkTextBox}"
                                                 ToolTip="Set to 0 to disable the database size warning entirely." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Repeat warning after (hours)" />
                                        <TextBox x:Name="TxtDatabaseSizeCooldown" Width="150" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="TxtDatabaseSizeCurrent" Style="{StaticResource Caption}"
                                                   Margin="0,0,0,6" />
                                        <Button Content="Compact database now" Style="{StaticResource ToolButton}"
                                                AutomationProperties.Name="Compact the monitoring database now"
                                                Click="DatabaseCompactFromSettings_Click" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live tail: which files the eye icon will open as text -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,6,0,4">
                            <StackPanel>
                                <TextBlock Text="Live file tail" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Text="The eye icon in a per-file breakdown streams a file's new lines as they are written. Files whose extension appears below are treated as binary and are never opened as text. Separate entries with semicolons." />
                                <TextBox x:Name="TxtBinaryExtensions" Style="{StaticResource DarkTextBox}"
                                         Margin="0,10,0,0" Width="Auto" HorizontalAlignment="Stretch"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Binary file extensions excluded from live tail" />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lines shown on open" />
                                        <TextBox x:Name="TxtTailInitialLines" Width="130" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum lines buffered" />
                                        <TextBox x:Name="TxtTailMaxLines" Width="150" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum decoded per poll (KiB)" />
                                        <TextBox x:Name="TxtTailMaxReadKb" Width="180" Style="{StaticResource DarkTextBox}"
                                                 ToolTip="Bounds memory and UI work per read. Total file size does not need to be limited because tailing seeks to the end." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum displayed text (KiB)" />
                                        <TextBox x:Name="TxtTailMaxBufferKb" Width="180" Style="{StaticResource DarkTextBox}"
                                                 ToolTip="Bounds retained decoded text even when a file contains extremely long minified lines." />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10" VerticalAlignment="Bottom">
                                        <Button Content="Restore default extensions" Style="{StaticResource ToolButton}"
                                                AutomationProperties.Name="Restore the default binary extension list"
                                                Click="RestoreBinaryExtensions_Click" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Web TBW lookup (on-device AI) -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,6,0,4">
                            <StackPanel>
                                <CheckBox x:Name="ChkTbwLookup" Foreground="{StaticResource TextPrimary}"
                                          Content="Search the web for each SSD's rated TBW on startup" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Evidence analysis" Margin="0,0,14,0" />
                                    <RadioButton x:Name="RadTbwLookupFoundry" GroupName="TbwLookupMode"
                                            Content="Foundry Local verification" Foreground="{StaticResource TextPrimary}"
                                            Checked="TbwLookupMethod_Checked" />
                                    <RadioButton x:Name="RadTbwLookupSerperOnly" GroupName="TbwLookupMode"
                                                 Content="Serper-only evidence parsing" Foreground="{StaticResource TextPrimary}"
                                            Margin="18,0,0,0" Checked="TbwLookupMethod_Checked" />
                                </StackPanel>
                                    <TextBlock x:Name="TbwLookupMethodHint" Style="{StaticResource Caption}"
                                         TextWrapping="Wrap" Margin="0,5,0,0"
                                         Text="Foundry verifies search evidence with an on-device model before candidates are shown." />
                                <Button Content="Guided Serper setup..." Style="{StaticResource ToolButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="TbwSetupShowFromSettings_Click" />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Search backend" />
                                        <ComboBox x:Name="TbwProviderSelector" Width="150">
                                            <ComboBoxItem Content="google" />
                                            <ComboBoxItem Content="serper" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Google API key" />
                                        <TextBox x:Name="TxtGoogleKey" Width="230" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Google engine id (cx)" />
                                        <TextBox x:Name="TxtGoogleCx" Width="180" Style="{StaticResource DarkTextBox}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Serper.dev API key" />
                                        <PasswordBox x:Name="TxtSerperKey" Width="230" Height="32"
                                                     Background="#15181B" Foreground="{StaticResource TextPrimary}"
                                                     BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                     Padding="6,4" PasswordChar="&#x25CF;" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Keys are stored per-user, not in the shared config. Google Custom Search JSON API now accepts existing customers only; new setups should use a Serper key from serper.dev." />
                            </StackPanel>
                        </Border>

                        <!-- Application updates -->
                        <Border Background="#15181B" CornerRadius="8" Padding="14,11" Margin="0,6,0,4">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Updates" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,10"
                                           Text="Checks the official GitHub release and accepts only the installer for this Windows architecture with matching size and SHA-256 metadata." />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Check for updates" />
                                        <ComboBox x:Name="AppUpdateModeSelector" Width="210">
                                            <ComboBoxItem Content="Ask me on startup" Tag="Prompt" />
                                            <ComboBoxItem Content="Automatic" Tag="Automatic" />
                                            <ComboBoxItem Content="Only when I ask" Tag="Manual" />
                                            <ComboBoxItem Content="Off" Tag="Off" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,10">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum installer size (MB)" />
                                        <TextBox x:Name="TxtMaxInstallerSizeMb" Width="150"
                                                 Style="{StaticResource DarkTextBox}"
                                                 AutomationProperties.Name="Maximum update installer size in megabytes" />
                                    </StackPanel>
                                    <Button Content="Check now" Style="{StaticResource ToolButton}"
                                            Margin="0,20,0,10" VerticalAlignment="Top"
                                            Click="CheckForUpdates_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="AppUpdateSettingsStatus" Style="{StaticResource Caption}"
                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkControllerErrors" Content="Monitor System log Disk event 11 controller errors"
                                      Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkNotify" Content="Show desktop notifications" Foreground="{StaticResource TextPrimary}"
                                      VerticalAlignment="Center" Margin="20,0,0,0" />
                            <Button Content="Save settings" Style="{StaticResource ToolButton}" Margin="20,0,0,0" Click="Save_Click" />
                            <TextBlock x:Name="SaveStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>

        <!-- Compiled HELP.md rendered in-app. WebView2 is initialized lazily on first open. -->
        <Grid x:Name="HelpOverlay" Grid.RowSpan="2" Panel.ZIndex="1200"
              Background="#E815181B" Visibility="Collapsed" Focusable="True"
              PreviewKeyDown="HelpOverlay_PreviewKeyDown">
                <Border MaxWidth="860" MaxHeight="680" Margin="28" VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,14,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11" Background="#223A66">
                            <TextBlock Text="?" FontSize="21" FontWeight="Bold" Foreground="#64A7FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Disk Activity Monitor Help" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Usage, settings, diagnostics, CLI, and troubleshooting"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close help (Esc)"
                                AutomationProperties.Name="Close help" Click="HelpClose_Click" />
                    </Grid>

                    <Border Grid.Row="1" Margin="20,0,20,0" Background="#15181B"
                            BorderBrush="#343B45" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="HelpWebView" Visibility="Collapsed"
                                          NavigationStarting="HelpWebView_NavigationStarting"
                                          NavigationCompleted="HelpWebView_NavigationCompleted" />

                            <StackPanel x:Name="HelpLoadingPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="220" Height="5" IsIndeterminate="True"
                                             Foreground="{StaticResource Accent}" Background="#252A31" />
                                <TextBlock Text="Loading compiled help..." Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>

                            <Grid x:Name="HelpFallbackPanel" Visibility="Collapsed" Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Help could not be rendered" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HelpFallbackMessage" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,12" />
                                </StackPanel>
                                <TextBox x:Name="HelpFallbackText" Grid.Row="1" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono"
                                         FontSize="12" Background="#111418" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource CardBorder}" Padding="12" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="20,12,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Press Esc to close. External links open in your default browser."
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolButton}"
                                Margin="12,0,0,0" Click="HelpClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Complete alert history, including records dismissed from the main Alert center -->
        <Grid x:Name="AlertHistoryOverlay" Grid.RowSpan="2" Panel.ZIndex="1050"
              Background="#E815181B" Visibility="Collapsed">
            <Border Width="760" MaxHeight="650" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#223A66">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="#64A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="All alerts" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Complete history, including alerts dismissed from the main Alert center"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close"
                                AutomationProperties.Name="Close all alerts" Click="AlertHistoryClose_Click" />
                    </Grid>

                    <Border Grid.Row="1" Margin="22,0,22,12" Background="#171A1F" CornerRadius="8" Padding="11,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dismissed alerts remain stored and can be restored here."
                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AlertHistorySummary" Grid.Column="1" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="22,0,16,0">
                        <ListBox x:Name="AlertHistoryList" Background="Transparent" BorderThickness="0"
                                 Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15181B" CornerRadius="7" Padding="11,9" Margin="0,0,6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding SeverityBrush}" CornerRadius="2" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                                               Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                </Grid>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                           FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="Dismiss" Style="{StaticResource ToolButton}" Padding="9,4"
                                                        Visibility="{Binding DismissVisibility}" CommandParameter="{Binding}"
                                                        Click="DismissHistoryAlert_Click" />
                                                <Button Content="Restore" Style="{StaticResource ToolButton}" Padding="9,4"
                                                        Foreground="{StaticResource Accent}" Visibility="{Binding RestoreVisibility}"
                                                        CommandParameter="{Binding}" Click="RestoreHistoryAlert_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="AlertHistoryEmpty" Text="No alerts have been recorded yet."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dismissal hides an occurrence; a future alert for the same condition can still appear."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolButton}"
                                Margin="14,0,0,0" Click="AlertHistoryClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Per-drive rated-TBW editor opened from the endurance rating pill -->
        <Grid x:Name="TbwEditOverlay" Grid.RowSpan="2" Panel.ZIndex="1080"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="TbwEditOverlay_PreviewKeyDown">
            <Grid.Resources>
                <Style x:Key="TbwEditModeOption" TargetType="RadioButton">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                    <Setter Property="Background" Value="#171A1F" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="ModeBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ModeBorder" Property="Background" Value="#2A2E34" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ModeBorder" Property="Background" Value="#253B5D" />
                                        <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border Width="570" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Change rated TBW" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="TbwEditTargetText" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DismissButton}" Width="30" Height="30"
                            FontSize="14" Content="&#x2715;" ToolTip="Cancel"
                            Click="TbwEditClose_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="22,0,22,18">
                        <Border Background="#171A1F" CornerRadius="8" Padding="13,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CURRENT RATING" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TbwEditCurrentText" Margin="0,3,0,0"
                                           FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="How should this drive's manufacturer endurance be represented?"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TbwEditSingle" Grid.Column="0" GroupName="TbwEditMode"
                                         Style="{StaticResource TbwEditModeOption}" Content="Single value"
                                         Checked="TbwEditMode_Checked" />
                            <RadioButton x:Name="TbwEditRange" Grid.Column="2" GroupName="TbwEditMode"
                                         Style="{StaticResource TbwEditModeOption}" Content="Value range"
                                         Checked="TbwEditMode_Checked" />
                        </Grid>
                        <TextBlock x:Name="TbwEditModeHint" Style="{StaticResource Caption}"
                                   Margin="0,0,0,15" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TbwEditLowerLabel" Style="{StaticResource FieldLabel}"
                                           Text="Rated TBW (TB)" />
                                <TextBox x:Name="TbwEditLowerText" Style="{StaticResource DarkTextBox}"
                                         Width="Auto" HorizontalAlignment="Stretch"
                                         TextChanged="TbwEditValues_TextChanged" />
                            </StackPanel>
                            <StackPanel x:Name="TbwEditUpperPanel" Grid.Column="2" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum TBW (TB)" />
                                <TextBox x:Name="TbwEditUpperText" Style="{StaticResource DarkTextBox}"
                                         Width="Auto" HorizontalAlignment="Stretch"
                                         TextChanged="TbwEditValues_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#171A1F" CornerRadius="8" Padding="13,10" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="AFTER SAVING" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TbwEditPreviewText" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TbwEditErrorText" Foreground="{StaticResource Critical}"
                                   Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="22,0,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Text="This changes only the selected drive." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource ToolButton}"
                                Click="TbwEditClose_Click" />
                            <Button x:Name="TbwEditSaveButton" Content="Save rating"
                                Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                IsDefault="True" Click="TbwEditSave_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- First-run / startup onboarding for online rated-TBW lookup -->
        <Grid x:Name="TbwSetupOverlay" Grid.RowSpan="2" Panel.ZIndex="1100"
              Background="#E815181B" Visibility="Collapsed">
            <Border Width="650" MaxHeight="640" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#223A66">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="#64A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Online rated-TBW lookup" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Optional setup" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Not now" Click="TbwSetupNotNow_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="22,0,22,0">
                        <!-- Step 1: consent -->
                        <StackPanel x:Name="TbwSetupIntroPanel">
                            <TextBlock Text="Would you like to configure online TBW lookups?"
                                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Text="Disk Activity Monitor can search for your SSD model's published endurance rating, then verify the evidence with a local on-device model." />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#171A1F" CornerRadius="8" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="ONLINE SEARCH" Style="{StaticResource Caption}" />
                                        <TextBlock Text="Serper" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="Only the drive model and search terms are sent to Serper."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#171A1F" CornerRadius="8" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL ANALYSIS" Style="{StaticResource Caption}" />
                                        <TextBlock Text="Foundry Local" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="Search evidence is analyzed on this computer; unsupported values are rejected."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#202933" CornerRadius="8" Padding="13" Margin="0,14,0,0">
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap"
                                           Text="Serper offers free starter credits and does not require a credit card for signup. The API key will be encrypted for your Windows account using DPAPI." />
                            </Border>
                        </StackPanel>

                        <!-- Step 2: Serper key -->
                        <StackPanel x:Name="TbwSetupKeyPanel" Visibility="Collapsed">
                            <TextBlock Text="Connect Serper" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Text="Create a free Serper account, open API keys, and copy the default key. Then paste it below." />

                            <Border Background="#171A1F" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#223A66">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#64A7FF" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="Create or sign in to Serper" FontWeight="SemiBold" />
                                        <TextBlock Text="No credit card is required for the free starter account."
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open Serper signup" Style="{StaticResource ToolButton}"
                                            Click="TbwSetupOpenSerper_Click" />
                                </Grid>
                            </Border>

                            <Border Background="#171A1F" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#223A66">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#64A7FF" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Paste your API key" FontWeight="SemiBold" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="TbwSetupSerperKey" Grid.Column="0" Height="34"
                                                         AutomationProperties.Name="Serper API key"
                                                         Background="#111418" Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                         Padding="9,6" PasswordChar="&#x25CF;" />
                                            <TextBox x:Name="TbwSetupSerperKeyReveal" Grid.Column="0" Height="34"
                                                     AutomationProperties.Name="Visible Serper API key"
                                                     Background="#111418" Foreground="{StaticResource TextPrimary}"
                                                     BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                     Padding="9,6" Visibility="Collapsed" />
                                            <ToggleButton x:Name="TbwSetupSerperKeyRevealButton" Grid.Column="1"
                                                          Width="36" Height="34" Margin="7,0,0,0" Padding="0"
                                                          Style="{StaticResource ToggleTool}"
                                                          AutomationProperties.Name="Show API key"
                                                          ToolTip="Show API key"
                                                          Checked="TbwSetupRevealKey_Checked"
                                                          Unchecked="TbwSetupRevealKey_Unchecked">
                                                <TextBlock x:Name="TbwSetupSerperKeyRevealGlyph" Text="&#xE890;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </ToggleButton>
                                        </Grid>
                                        <TextBlock x:Name="TbwSetupErrorText" Foreground="{StaticResource Critical}"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="22,18,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="TbwSetupDontShowAgain" Content="Don't show this again"
                                  Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <StackPanel x:Name="TbwSetupIntroButtons" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Not now" Style="{StaticResource ToolButton}" Click="TbwSetupNotNow_Click" />
                            <Button Content="Configure" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"
                                    Click="TbwSetupConfigure_Click" />
                        </StackPanel>
                        <StackPanel x:Name="TbwSetupKeyButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="Back" Style="{StaticResource ToolButton}" Click="TbwSetupBack_Click" />
                            <Button Content="Save &amp; enable" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"
                                    Click="TbwSetupSave_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Rated-TBW lookup: modal workflow opened from the endurance badge -->
        <Grid x:Name="TbwLookupPanel" Grid.RowSpan="2" Panel.ZIndex="990"
              Background="#E815181B" Visibility="Collapsed">
            <Border Width="680" MaxHeight="620" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="22,18,16,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#223A66">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="#64A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Rated TBW lookup" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="TbwLookupTargetText" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close" Click="TbwLookupClose_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="22,0,16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,10">
                            <!-- Current lookup state -->
                            <Border x:Name="TbwLookupStateBorder" Background="#243247" CornerRadius="10" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#3315181B">
                                        <TextBlock x:Name="TbwLookupStateGlyph" Text="&#xE895;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#64A7FF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TbwLookupHeadline" Text="Preparing lookup"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TbwLookupStatus" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="TbwLookupAction" Grid.Column="2"
                                            Style="{StaticResource ToolButton}" Visibility="Collapsed"
                                            Click="TbwLookupAction_Click" Content="" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ProgressBar x:Name="TbwLookupProgressBar" Height="5" IsIndeterminate="True"
                                         Foreground="{StaticResource Accent}" Background="#15181B"
                                         BorderThickness="0" Margin="0,13,0,0" />

                            <!-- Search pipeline explanation -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#171A1F" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="WEB EVIDENCE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="Serper search" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="Finds exact-model specifications and endurance references."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#171A1F" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="TbwLookupAnalysisHeading" Text="LOCAL VERIFICATION" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="TbwLookupAnalysisTitle" Text="On-device model" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock x:Name="TbwLookupAnalysisText" Text="Extracts candidates; unsupported values are rejected."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="TbwCandidateList" Margin="0,13,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="22,13,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TbwLookupFooterText" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Nothing changes until you explicitly apply a candidate." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                            <Button x:Name="TbwLookupRawResultsButton" Content="Raw results"
                                Style="{StaticResource ToolButton}" Visibility="Collapsed"
                                Click="TbwLookupRawResults_Click" />
                            <Button x:Name="TbwLookupAgainButton" Content="Search again"
                                Style="{StaticResource ToolButton}" Visibility="Collapsed" Margin="8,0,0,0"
                                    Click="TbwLookupAgain_Click" />
                            <Button Content="Close" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Click="TbwLookupClose_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Exact search/model API response viewer opened from Rated TBW lookup -->
        <Grid x:Name="TbwRawResultsOverlay" Grid.RowSpan="2" Panel.ZIndex="1250"
              Background="#E815181B" Visibility="Collapsed">
            <Border Width="900" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="680" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lookup raw results" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Exact provider response bodies, formatted for inspection"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close raw results"
                                Click="TbwRawResultsClose_Click" />
                    </Grid>

                    <TabControl x:Name="TbwRawResultsTabs" Grid.Row="1" Margin="22,0,22,0"
                                Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Setter Property="Background" Value="#171A1F" />
                                <Setter Property="Padding" Value="14,8" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                                    CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#2A2E34" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#343A42" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem x:Name="TbwRawSearchTab" Header="Serper response">
                            <Grid Background="#171A1F">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TbwRawSearchMeta" Style="{StaticResource Caption}"
                                           Margin="12,10,12,8" TextWrapping="Wrap" />
                                <TextBox x:Name="TbwRawSearchText" Grid.Row="1" Margin="8,0,8,8"
                                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Cascadia Mono" FontSize="12" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Background="#111418" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                         Padding="12" />
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="TbwRawModelTab" Header="Model response">
                            <Grid Background="#171A1F">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TbwRawModelMeta" Style="{StaticResource Caption}"
                                           Margin="12,10,12,8" TextWrapping="Wrap" />
                                <TextBox x:Name="TbwRawModelText" Grid.Row="1" Margin="8,0,8,8"
                                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Cascadia Mono" FontSize="12" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Background="#111418" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                         Padding="12" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="2" Margin="22,13,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="API keys are never included. Model reasoning appears only when the local API returned it; hidden reasoning is not reconstructed." />
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolButton}"
                                Margin="14,0,0,0" Click="TbwRawResultsClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Live SMART scan: modal in-app diagnostic surface opened from controller alerts -->
        <Grid x:Name="SmartScanOverlay" Grid.RowSpan="2" Panel.ZIndex="1000"
              Background="#E815181B" Visibility="Collapsed">
            <Border Width="700" MaxHeight="650" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="22,18,16,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#223A66">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                       Foreground="#64A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Live SMART scan" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="SmartScanTargetText" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close" Click="SmartScanClose_Click" />
                    </Grid>

                    <!-- Progress state -->
                    <Grid x:Name="SmartScanProgressPanel" Grid.Row="1" Margin="22,10,22,24">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="38" Background="#242D3A"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Reading drive health telemetry" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="SmartScanProgressText" Style="{StaticResource Caption}"
                                       Text="Preparing scan..." HorizontalAlignment="Center" Margin="0,6,0,14" />
                            <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource Accent}"
                                         Background="#15181B" BorderThickness="0" />
                            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="24,16,24,0"
                                       Text="This is a read-only scan. It queries Windows health, storage reliability counters and direct NVMe SMART telemetry when the hardware exposes them." />
                        </StackPanel>
                    </Grid>

                    <!-- Results state -->
                    <ScrollViewer x:Name="SmartScanResultPanel" Grid.Row="1" Margin="22,0,16,0"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,6,10">
                            <Border x:Name="SmartScanStatusBorder" CornerRadius="10" Padding="14" Background="#2B3037">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#3315181B">
                                        <TextBlock x:Name="SmartScanStatusGlyph" Text="?" FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SmartScanStatusTitle" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SmartScanStatusText" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Four glanceable health metrics -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#171A1F" CornerRadius="8" Padding="11" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="WINDOWS HEALTH" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="SmartScanWindowsValue" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="SmartScanWindowsSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#171A1F" CornerRadius="8" Padding="11" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="SMART ACCESS" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="SmartScanTelemetryValue" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="SmartScanTelemetrySub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#171A1F" CornerRadius="8" Padding="11" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="CONNECTION" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="SmartScanConnectionValue" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="SmartScanConnectionSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="#171A1F" CornerRadius="8" Padding="11" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="SmartScanTempValue" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <TextBlock x:Name="SmartScanTempSub" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Device identity -->
                            <Border Background="#171A1F" CornerRadius="8" Padding="13" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Model" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SmartScanModelValue" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Firmware" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="SmartScanFirmwareValue" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="Serial" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SmartScanSerialValue" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Device path" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="SmartScanPathValue" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="Lifetime I/O" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SmartScanLifetimeValue" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Scanned" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="SmartScanTimeValue" Margin="0,7,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Text="SCAN FINDINGS" Style="{StaticResource Caption}" Margin="2,14,0,7" />
                            <ItemsControl x:Name="SmartScanFindings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#x2022;" Foreground="{StaticResource Accent}" FontSize="17" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="22,13,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Read-only diagnostic. No destructive test or write command is sent to the drive." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                            <Button x:Name="SmartScanAgainButton" Content="Scan again" Style="{StaticResource ToolButton}"
                                    Visibility="Collapsed" Click="SmartScanAgain_Click" />
                            <Button Content="Close" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Click="SmartScanClose_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- First-run consent: no network update request occurs until the user chooses. -->
        <Grid x:Name="AppUpdateConsentOverlay" Grid.RowSpan="2" Panel.ZIndex="1300"
              Background="#E815181B" Visibility="Collapsed" Focusable="True">
            <Border Width="640" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="21" FontWeight="SemiBold" Text="Application updates" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="Choose when Disk Activity Monitor may contact GitHub." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Decide later"
                                AutomationProperties.Name="Decide about update checks later"
                                Click="AppUpdateConsentClose_Click" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                               Text="Update checks read the public latest-release metadata from the official Disk Activity Monitor GitHub repository. No release information is requested until you make a choice." />
                    <Border Background="#15181B" CornerRadius="8" Padding="13" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Downloads are never installed silently. The app selects only your architecture, verifies the GitHub size and SHA-256 digest, then asks again before launching the installer." />
                    </Border>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Off" Style="{StaticResource ToolButton}"
                                Margin="0,0,8,0" Click="AppUpdateConsentOff_Click" />
                        <Button Content="Only when I ask" Style="{StaticResource ToolButton}"
                                Margin="0,0,8,0" Click="AppUpdateConsentManual_Click" />
                        <Button Content="Automatic" Style="{StaticResource ToolButton}"
                                Click="AppUpdateConsentAutomatic_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Verified application update workflow. -->
        <Grid x:Name="AppUpdateOverlay" Grid.RowSpan="2" Panel.ZIndex="1280"
              Background="#E815181B" Visibility="Collapsed" Focusable="True"
              PreviewKeyDown="AppUpdateOverlay_PreviewKeyDown">
            <Border Width="720" Margin="28" VerticalAlignment="Stretch"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="8" Background="#213C31">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                       Foreground="#58C88B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppUpdateTitle" FontSize="19" FontWeight="SemiBold"
                                       Text="Application update" TextWrapping="Wrap" />
                            <TextBlock Text="Official GitHub release" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close"
                                AutomationProperties.Name="Close application update"
                                Click="AppUpdateClose_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="22,0,16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,10">
                            <TextBlock x:Name="AppUpdateMessage" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}" />
                            <Border x:Name="AppUpdateNotesPanel" Background="#15181B" CornerRadius="8"
                                    Padding="13" Margin="0,14,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Release notes" />
                                    <ctl:MarkdownViewer x:Name="AppUpdateNotes" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <ProgressBar x:Name="AppUpdateProgress" Height="8" Margin="0,16,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <TextBlock x:Name="AppUpdateStatus" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Text="Disk Activity Monitor verifies the installer again immediately before launch. Installation still requires your Windows approval." />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="22,13,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="AppUpdateOpenReleaseButton" Content="Open release"
                                    Style="{StaticResource ToolButton}" Visibility="Collapsed"
                                    Click="AppUpdateOpenRelease_Click" />
                            <Button x:Name="AppUpdateOpenFolderButton" Content="Open folder"
                                    Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="AppUpdateOpenFolder_Click" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" Margin="14,0,0,0">
                            <Button x:Name="AppUpdateSkipButton" Content="Skip this version"
                                    Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="AppUpdateSkip_Click" />
                            <Button x:Name="AppUpdateLaterButton" Content="Later"
                                    Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                                    Click="AppUpdateClose_Click" />
                            <Button x:Name="AppUpdatePrimaryButton" Content="Download update"
                                    Style="{StaticResource ToolButton}" Visibility="Collapsed"
                                    Click="AppUpdatePrimary_Click" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Per-file drill-down: explains an opaque writer by showing the files it wrote -->
        <Grid x:Name="FileTargetsOverlay" Grid.RowSpan="2" Panel.ZIndex="1000"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="FileTargetsOverlay_PreviewKeyDown" Focusable="True">
                <Border x:Name="FileTargetsDialogBorder" MaxWidth="1020" Margin="28"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#223A66">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                       Foreground="#64A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileTargetsTitle" FontSize="19" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FileTargetsSubtitle" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="BtnFileTargetsAnalytics" Grid.Column="2" IsChecked="True"
                                      Style="{StaticResource ToggleTool}" Margin="0,0,8,0"
                                      Content="Analytics" ToolTip="Show or hide the analytics charts"
                                      AutomationProperties.Name="Toggle analytics charts"
                                      Click="FileTargetsAnalyticsToggle_Click" />
                        <Button Grid.Column="3" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close"
                                AutomationProperties.Name="Close file breakdown"
                                Click="FileTargetsClose_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="22,0,16,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,10">
                            <Border x:Name="FileTargetsNoteBorder" CornerRadius="10" Padding="13"
                                    Background="#232B38" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock x:Name="FileTargetsNote" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Border>

                            <!-- Analytics: share of system writes, this process's write timeline,
                                 and which file types absorb the writes. -->
                            <Border x:Name="FileTargetsAnalytics" CornerRadius="10" Padding="14"
                                    Background="#191D22" BorderBrush="#2C333C" BorderThickness="1"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                            <TextBlock Text="Share of writes by process" FontWeight="SemiBold"
                                                       FontSize="12" Margin="0,0,0,2" />
                                            <TextBlock x:Name="FileTargetsPieCaption" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <ctl:PieChart x:Name="FileTargetsPie" Height="168" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <TextBlock Text="Write volume over time" FontWeight="SemiBold"
                                                       FontSize="12" Margin="0,0,0,2" />
                                            <TextBlock x:Name="FileTargetsTimelineCaption" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <ctl:BarChart x:Name="FileTargetsTimeline" Height="168" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Bytes written by file type" FontWeight="SemiBold"
                                               FontSize="12" Margin="0,14,0,2" />
                                    <TextBlock x:Name="FileTargetsTypesCaption" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <ItemsControl x:Name="FileTargetsTypesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                    <Grid Grid.Column="1" Margin="6,0,10,0">
                                                        <Border Height="9" CornerRadius="4" HorizontalAlignment="Stretch"
                                                                Background="#232A33" />
                                                        <Border Height="9" CornerRadius="4" HorizontalAlignment="Left"
                                                                Width="{Binding BarWidth}" Background="{Binding Fill}" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11.5"
                                                               VerticalAlignment="Center" MinWidth="74"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="FileTargetsTypesEmpty" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="No per-file records in this window, so file types cannot be summarised." />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="FileTargetsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#15181B" CornerRadius="6" Padding="11,8" Margin="0,0,0,7">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Copy full path" Click="FileTargetCopyPath_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Background="#232A33" CornerRadius="4" Padding="6,1"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondary}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding WriteText}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                                        <Button Style="{StaticResource RowActionButton}"
                                                                ToolTip="Copy full path"
                                                                AutomationProperties.Name="{Binding CopyAutomationName}"
                                                                Click="FileTargetCopyPath_Click">
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource RowActionButton}"
                                                                IsEnabled="{Binding CanTail}"
                                                                ToolTip="{Binding TailToolTip}"
                                                                AutomationProperties.Name="{Binding TailAutomationName}"
                                                                Click="FileTargetTail_Click">
                                                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource RowActionButton}"
                                                                ToolTip="Find which processes have this file open"
                                                                AutomationProperties.Name="{Binding TraceAutomationName}"
                                                                Click="FileTargetTrace_Click">
                                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource RowDeleteButton}"
                                                                ToolTip="Delete this file"
                                                                AutomationProperties.Name="{Binding DeleteAutomationName}"
                                                                Click="FileTargetDelete_Click">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                                           Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <Grid Margin="0,6,0,0">
                                                    <Border Height="6" CornerRadius="3" HorizontalAlignment="Stretch"
                                                            Background="#232A33" />
                                                    <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                                            Width="{Binding BarWidth}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#4FC3F7" Offset="0" />
                                                                <GradientStop Color="#2979FF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
                                                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="FileTargetsEmpty" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="22,13,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileTargetsFooter" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="BtnTraceProcess" Grid.Column="1" Content="Trace open handles"
                                Style="{StaticResource ToolButton}" Margin="14,0,0,0"
                                ToolTip="List every file and object this process currently has open (Sysinternals Handle)"
                                AutomationProperties.Name="Trace open handles for this process"
                                Click="TraceProcessHandles_Click" />
                        <Button Grid.Column="2" Content="Close" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Click="FileTargetsClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Sysinternals Handle output: which processes hold a file or what a process has open. -->
        <Grid x:Name="HandleTraceOverlay" Grid.RowSpan="2" Panel.ZIndex="1320"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="HandleTraceOverlay_PreviewKeyDown" Focusable="True">
            <Border Width="960" Margin="34" VerticalAlignment="Stretch"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#2E2740">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#C7A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HandleTraceTitle" FontSize="19" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HandleTraceSubtitle" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close"
                                AutomationProperties.Name="Close handle trace"
                                Click="HandleTraceClose_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="22,0,22,10">
                        <!-- Shown when Handle is not installed: explains the download before it happens. -->
                        <Border x:Name="HandleInstallPrompt" CornerRadius="10" Padding="14"
                                Background="#232B38" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Sysinternals Handle is required" FontWeight="SemiBold"
                                           Margin="0,0,0,5" />
                                <TextBlock x:Name="HandleInstallText" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondary}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="BtnHandleDownload" Content="Download Handle"
                                            Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                                            AutomationProperties.Name="Download Sysinternals Handle"
                                            Click="HandleDownload_Click" />
                                    <Button Content="Not now" Style="{StaticResource ToolButton}"
                                            Click="HandleTraceClose_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="HandleTraceStatusBorder" CornerRadius="10" Padding="12"
                                Background="#232B38" Visibility="Collapsed" Margin="0,0,0,0">
                            <TextBlock x:Name="HandleTraceStatus" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Border>

                        <ItemsControl x:Name="HandleLockerList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#15181B" CornerRadius="6" Padding="11,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="#232A33" CornerRadius="4" Padding="6,1"
                                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PidText}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                           ToolTip="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="22,0,22,0" CornerRadius="8" Background="#101316"
                            BorderBrush="#2C333C" BorderThickness="1" ClipToBounds="True">
                        <TextBox x:Name="HandleTraceOutput" Style="{StaticResource ConsoleText}" />
                    </Border>

                    <Grid Grid.Row="3" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HandleTraceFooter" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="BtnHandleCopy" Grid.Column="1" Content="Copy output"
                                Style="{StaticResource ToolButton}" Margin="14,0,0,0"
                                AutomationProperties.Name="Copy handle output to clipboard"
                                Click="HandleTraceCopy_Click" />
                        <Button Grid.Column="2" Content="Close" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                Click="HandleTraceClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Live tail of a text file written by the selected process. -->
        <Grid x:Name="FileTailOverlay" Grid.RowSpan="2" Panel.ZIndex="1330"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="FileTailOverlay_PreviewKeyDown" Focusable="True">
            <Border Width="1000" Margin="34" VerticalAlignment="Stretch"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="22,18,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1F3A33">
                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#6FD8A8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileTailTitle" FontSize="19" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FileTailPath" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource DismissButton}" Width="30" Height="30"
                                FontSize="14" Content="&#x2715;" ToolTip="Close"
                                AutomationProperties.Name="Close live tail"
                                Click="FileTailClose_Click" />
                    </Grid>

                    <Border Grid.Row="1" Margin="22,0,22,0" CornerRadius="8" Background="#101316"
                            BorderBrush="#2C333C" BorderThickness="1" ClipToBounds="True">
                        <TextBox x:Name="FileTailOutput" Style="{StaticResource ConsoleText}" />
                    </Border>

                    <Grid Grid.Row="2" Margin="22,12,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileTailStatus" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <CheckBox x:Name="ChkFileTailFollow" Grid.Column="1" IsChecked="True" Margin="14,0,10,0"
                                  VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                  Content="Follow" ToolTip="Keep scrolling to the newest line" />
                        <Button x:Name="BtnFileTailPause" Grid.Column="2" Content="Pause"
                                Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                                AutomationProperties.Name="Pause or resume the live tail"
                                Click="FileTailPause_Click" />
                        <Button Grid.Column="3" Content="Close" Style="{StaticResource ToolButton}"
                                Click="FileTailClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Delete confirmation and its outcome, including lock diagnosis. -->
        <Grid x:Name="FileDeleteOverlay" Grid.RowSpan="2" Panel.ZIndex="1340"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="FileDeleteOverlay_PreviewKeyDown" Focusable="True">
            <Border Width="640" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="11" Background="#4A2226"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="FileDeleteIcon" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#FF8A80"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock x:Name="FileDeleteTitle" FontSize="19" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="FileDeleteMessage" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#15181B" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="FileDeletePath" TextWrapping="Wrap" FontSize="11.5"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Border>

                    <Border x:Name="FileDeleteLockBorder" Background="#232B38" CornerRadius="8" Padding="12"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="FileDeleteLockTitle" FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,0,6" TextWrapping="Wrap" />
                            <ItemsControl x:Name="FileDeleteLockList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#15181B" CornerRadius="4" Padding="6,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PidText}" FontSize="10.5"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BtnFileDeleteDiagnose" Content="Find what is locking it"
                                Style="{StaticResource ToolButton}" Margin="0,0,8,0" Visibility="Collapsed"
                                AutomationProperties.Name="Find which process is locking this file"
                                Click="FileDeleteDiagnose_Click" />
                        <Button x:Name="BtnFileDeleteCancel" Content="Cancel" Style="{StaticResource ToolButton}"
                                Margin="0,0,8,0" Click="FileDeleteCancel_Click" />
                        <Button x:Name="BtnFileDeleteConfirm" Content="Delete file"
                                Style="{StaticResource ToolButton}"
                                AutomationProperties.Name="Confirm deleting this file"
                                Click="FileDeleteConfirm_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Database growth warning with an offline compaction offer. -->
        <Grid x:Name="DatabaseSizeOverlay" Grid.RowSpan="2" Panel.ZIndex="1310"
              Background="#E815181B" Visibility="Collapsed"
              PreviewKeyDown="DatabaseSizeOverlay_PreviewKeyDown" Focusable="True">
            <Border Width="640" Margin="28" VerticalAlignment="Center"
                    Background="#1E2228" BorderBrush="#3A414A" BorderThickness="1"
                    CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.65" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="11" Background="#4A3A1E"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#F0A020" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock x:Name="DatabaseSizeTitle" FontSize="19" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Text="The monitoring database is large" />
                            <TextBlock x:Name="DatabaseSizeMessage" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#15181B" CornerRadius="8" Padding="13">
                        <TextBlock x:Name="DatabaseSizeDetail" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Border>

                    <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BtnDatabaseSizeSettings" Content="Change threshold"
                                Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                                Click="DatabaseSizeSettings_Click" />
                        <Button x:Name="BtnDatabaseSizeLater" Content="Not now" Style="{StaticResource ToolButton}"
                                Margin="0,0,8,0" Click="DatabaseSizeClose_Click" />
                        <Button x:Name="BtnDatabaseCompact" Content="Compact now"
                                Style="{StaticResource ToolButton}"
                                AutomationProperties.Name="Compact the monitoring database now"
                                Click="DatabaseCompact_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
