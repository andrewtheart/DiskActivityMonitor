<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiskActivityMonitor.Tray</RootNamespace>
    <AssemblyName>DiskActivityMonitor.Tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- WPF reads DPI awareness from the manifest; silence the WinForms-only DPI analyzer. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskActivityMonitor.Core\DiskActivityMonitor.Core.csproj" />
  </ItemGroup>

  <!-- WinForms implicit usings add System.Drawing globally, which clashes with WPF's
       System.Windows.Media (Brush, Color, Pen, Point). The few files that need GDI+ types
       import System.Drawing explicitly, so remove it from the implicit set. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
