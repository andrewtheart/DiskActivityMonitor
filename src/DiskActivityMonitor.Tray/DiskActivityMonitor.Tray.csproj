<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiskActivityMonitor.Tray</RootNamespace>
    <AssemblyName>DiskActivityMonitor.Tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- WPF reads DPI awareness from the manifest; silence the WinForms-only DPI analyzer. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- Convert the repository HELP.md into a standalone, navigable HTML document on build.
       If pandoc is unavailable, retain and ship the last generated HELP.html. -->
  <Target Name="ConvertHelpMdToHtml"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)..\..\HELP.md;$(MSBuildThisFileDirectory)help-style.html"
          Outputs="$(MSBuildThisFileDirectory)HELP.html">
    <Exec Command="pandoc &quot;$(MSBuildThisFileDirectory)..\..\HELP.md&quot; -s --toc --toc-depth=3 --mathml --metadata pagetitle=&quot;Disk Activity Monitor Help&quot; --include-in-header=&quot;$(MSBuildThisFileDirectory)help-style.html&quot; -o &quot;$(MSBuildThisFileDirectory)HELP.html&quot;"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <Content Include="HELP.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\HELP.md" Link="HELP.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\..\assets\app-icon.png" Link="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskActivityMonitor.Core\DiskActivityMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiskActivityMonitor.Tests" />
  </ItemGroup>

  <!-- WinForms implicit usings add System.Drawing globally, which clashes with WPF's
       System.Windows.Media (Brush, Color, Pen, Point). The few files that need GDI+ types
       import System.Drawing explicitly, so remove it from the implicit set. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
